# ===== SI-RTLH Konawe — Contoh Variabel Lingkungan =====
# Salin file ini menjadi .env (lokal) atau isi di dashboard Vercel (produksi).

# Koneksi PostgreSQL. Contoh Neon/Supabase umumnya menyertakan ?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/nama_db?sslmode=require

# Rahasia penandatanganan sesi login (WAJIB unik & panjang di produksi)
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=ganti-dengan-string-acak-minimal-48-karakter

# URL CSV spreadsheet jawaban Google Form
# (Spreadsheet → File/Berkas → Publikasikan ke web → Form Responses 1 → CSV)
GOOGLE_SHEET_CSV_URL=

# URL embed Google My Maps
# (mymaps.google.com → Bagikan Publik → menu "Sematkan di situs saya" → salin nilai src iframe)
NEXT_PUBLIC_MY_MAPS_URL=

# URL Google Form pendataan (untuk tombol "Isi Formulir Usulan" di beranda)
NEXT_PUBLIC_GOOGLE_FORM_URL=
